{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsc-e2e",
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "e2e/**/*",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ]
}
